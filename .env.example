# Placeholders only. Copy to ignored .env and replace before starting Compose.
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
MYSQL_PASSWORD=replace-with-a-unique-app-password
REDIS_PASSWORD=replace-with-a-unique-redis-password
NODEWATCH_HEARTBEAT_TTL=30s
NODEWATCH_FRESHNESS_THRESHOLD=2m
NODEWATCH_ALERT_EVALUATION_INTERVAL=10s
NODEWATCH_ALERT_FOR=30s
NODEWATCH_FILESYSTEM_WARNING_PERCENT=85
NODEWATCH_FILESYSTEM_CRITICAL_PERCENT=95
NODEWATCH_IOWAIT_WARNING_PERCENT=20
NODEWATCH_IOWAIT_CRITICAL_PERCENT=40
NODEWATCH_RECONCILIATION_INTERVAL=30s
NODEWATCH_RECONCILIATION_BATCH_SIZE=100
NODEWATCH_RECONCILIATION_MAX_BATCHES=5
NODEWATCH_CACHE_RETRY_ATTEMPTS=3
# Agent remains a separate Linux process; use its reachable collector address.
NODEWATCH_COLLECTOR_URL=http://localhost:8080/api/v1/metrics
NODEWATCH_NODE_ID=demo-linux
